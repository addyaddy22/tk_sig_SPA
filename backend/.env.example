# PostgreSQL - user/password/db must match POSTGRES_* in the root .env
DATABASE_URL="postgresql://spa:CHANGE_ME@localhost:5432/tk_sig_spa?schema=public"

PORT=3000
CORS_ORIGIN=http://localhost:5173

# Auth - CHANGE JWT_SECRET in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Business rules
BUSINESS_NAME="TK Signature Spa"
SPA_TIMEZONE=Africa/Harare
CURRENCY=USD
# Slot grid granularity in minutes (bookings start on multiples of this)
SLOT_STEP_MIN=15
# Clients must book at least this many minutes ahead
MIN_LEAD_MIN=60
# How far ahead clients can book
BOOKING_HORIZON_DAYS=60

# Interactive API docs (Swagger UI) at /api/docs - set false to hide in production
SWAGGER_ENABLED=true
